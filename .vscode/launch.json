{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debugpy: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "logToFile": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
   {
      "name": "API: Launch Flask Service",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/door_controller/api.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
      }
    },
    {
      "name": "Client: get_swipes",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/door_controller/cli_synch_tools/get_swipes.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Client + API (Local)",
      "configurations": [
        "API: Launch Flask Service",
        "Client: get_swipes"
      ],
      "stopAll": true
    }
  ]
}