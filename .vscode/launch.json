{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "debugpy: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "logToFile": true,
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Python: Attach to Docker Flask",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app"
        }
      ],
      "justMyCode": true
    },
    {
      "name": "get_swipes Client: Launch Script",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/door_controller/cli_synch_tools/get_swipes.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Client + API",
      "configurations": [
        "Python: Attach to Docker Flask",
        "get_swipes Client: Launch Script"
      ],
      "stopAll": true
    }
  ]
}