# Stage 1: Builder
FROM python:3.10-slim-buster AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and install Python package
COPY door_controller /app/door_controller
COPY setup.py /app/setup.py
COPY init /app/init
RUN pip install --no-cache-dir .

# Stage 2: Production Runtime
FROM python:3.10-slim-buster

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Create non-root user and application directories
RUN adduser --system --group doorcontroller && \
    mkdir -p /app/data /app/config /app/log /app/init && \
    chown -R doorcontroller:doorcontroller /app

USER doorcontroller

# Copy database init scripts, python site-packages, and CLI entry points from builder
COPY --chown=doorcontroller:doorcontroller --from=builder /app/init /app/init
COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

CMD ["echo", "Ready. Run CLI tools: get_swipes, get_acl_from_controller, get_foblist_from_controller, list_fobs, list_fobs_simple, BeSeen_driver, BeSeen_config_gui, sync_controller, trim_fobs, update_access, deploy_triggers, or collect_metrics"]

