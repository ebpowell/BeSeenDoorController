# Stage 1: Builder
FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and install Python package
COPY door_controller /app/door_controller
COPY setup.py /app/setup.py
COPY init /app/init
RUN pip install --no-cache-dir .

# Stage 2: Production Runtime
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_CONFIG_DIR=/app/config

WORKDIR /app

# Create non-root user and application directories
RUN adduser --system --group doorcontroller && \
    mkdir -p /app/data /app/config /app/log /app/init && \
    chown -R doorcontroller:doorcontroller /app

USER doorcontroller

# Copy database init scripts, python site-packages, and entry points from builder
COPY --chown=doorcontroller:doorcontroller --from=builder /app/init /app/init
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

EXPOSE 5000

# Standalone REST API server entrypoint controlling hardware controller calls
CMD ["BeSeen_api", "--host", "0.0.0.0", "--port", "5000"]
